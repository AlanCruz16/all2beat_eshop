# Convex
# From `npx convex dev` / the Convex dashboard (Settings > URL & Deploy Key)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Clerk (admin auth only — no customer accounts)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# JWT issuer domain for the Clerk JWT template used by convex/auth.config.ts
CLERK_JWT_ISSUER_DOMAIN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
