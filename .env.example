# Convex
# From `npx convex dev` / the Convex dashboard (Settings > URL & Deploy Key)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Clerk (admin auth only — no customer accounts)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# JWT issuer domain for the Clerk JWT template used by convex/auth.config.ts
CLERK_JWT_ISSUER_DOMAIN=
# The only sign-in page on the site lives under /admin (ticket 08). Without
# this, Clerk redirects unauthenticated admin traffic to its own hosted page
# instead of ours.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
#
# Not an env var, but required for /admin to admit anyone: the admin's Clerk
# user needs `{"role": "admin"}` in their public metadata, and both the session
# token and the `convex` JWT template need a `publicMetadata` claim set to
# `{{user.public_metadata}}` (Clerk Dashboard → Sessions / JWT Templates).
# Middleware reads the first, `convex/authz.ts` reads the second.

# Stripe
#
# This file and each Convex deployment are separate stores — a key set here is
# not set there, and dev and prod Convex are separate from each other too. Two
# runtimes call Stripe, which is why the secret key belongs in all three:
# the Next server creates checkout sessions (ticket 05), and a Convex Node
# action mirrors products (ticket 04).
#
#   npx convex env set STRIPE_SECRET_KEY sk_... [--prod]
STRIPE_SECRET_KEY=
# Required for embedded checkout (ADR-0003) — Stripe.js will not load without
# it, so /checkout cannot render. Public by design (it ships in the browser
# bundle); it is NOT the secret key above.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
#
# STRIPE_WEBHOOK_SECRET is deliberately NOT in this file. The webhook is a
# Convex httpAction (ticket 06), so it is only ever read there:
#   npx convex env set STRIPE_WEBHOOK_SECRET whsec_... [--prod]

# Optional. The absolute origin Stripe sends the shopper back to after an
# embedded checkout. Derived from the request headers when unset, which covers
# localhost, preview URLs, and production — set it only for a deployment fronted
# by a domain the request headers don't reveal.
NEXT_PUBLIC_SITE_URL=
